{
  "name": "novelin",
  "version": "0.1.0",
  "private": true,
  "description": "Local AI novel writing terminal",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test",
    "build:vendor": "esbuild scripts/cm6-entry.js --bundle --format=esm --minify --legal-comments=eof --outfile=public/vendor/codemirror.js"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "dompurify": "^3.4.17",
    "express": "^4.21.2",
    "katex": "^0.19.1",
    "marked": "^18.1.2"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "geckodriver": "^8.0.0"
  }
}
